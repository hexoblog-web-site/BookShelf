    <% if (page && page.layout === 'tags') { %>
    <link rel="stylesheet" type="text/css" href="<%- url_for('/style/tags-list.css') %>">
    <% } %>
    <% /* 站长名片（文章页侧栏顶部），配置文件 _config.yml 的 user_card 段 */ %>
    <link rel="stylesheet" type="text/css" href="<%- url_for('/style/user-card.css') %>">
    <% /* /links/ 友链页（Butterfly flink 版式），只有该页用得上，按需加载 */ %>
    <% if (page && page.layout === 'links') { %>
    <link rel="stylesheet" type="text/css" href="<%- url_for('/style/links-page.css') %>">
    <% } %>
    <% /* /fcircle/ 朋友圈页，只有该页用得上，按需加载 */ %>
    <% if (page && page.layout === 'fcircle') { %>
    <link rel="stylesheet" type="text/css" href="<%- url_for('/style/fcircle-page.css') %>">
    <% } %>
    <% /* /equipment/ 装备页，只有该页用得上，按需加载 */ %>
    <% if (page && page.layout === 'equipment') { %>
    <link rel="stylesheet" type="text/css" href="<%- url_for('/style/equipment-page.css') %>">
    <% } %>
    <% /* /recommend/ 推荐页，只有该页用得上，按需加载 */ %>
    <% if (page && page.layout === 'recommend') { %>
    <link rel="stylesheet" type="text/css" href="<%- url_for('/style/recommend-page.css') %>">
    <% } %>
    <% /* /about/ 关于页，只有该页用得上，按需加载 */ %>
    <% if (page && page.layout === 'about') { %>
    <link rel="stylesheet" type="text/css" href="<%- url_for('/style/about-page.css') %>">
    <%- partial('_partial/about-head') %>
    <% } %>
    <link rel="icon" href="<%- url_for('/favicon.ico') %>" sizes="any">
    <link rel="apple-touch-icon" href="<%- url_for('/images/apple-touch-icon.png') %>">
    <meta name="theme-color" content="<%- vt_get_config('basic_style', '#f45d1d') %>">

<%_ /* 自定义注入（head）：主题 _config.yml 的 inject.head，按配置顺序原样输出。
       放在所有主题样式之后——后写的规则优先，才能覆盖主题默认样式。
       顶格调用：多行内容的缩进由 scripts/inject.js 统一处理。 */ _%>
<%- vt_inject('head') %>
</head>


<body class="<%= dark_mode_class %>" <%= sticky_header %>>

