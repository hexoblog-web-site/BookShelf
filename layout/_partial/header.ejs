                            <div class="user-meta">
                                <div class="user-nickname" style="cursor: pointer;"><%= __('Please log in') %></div>
                                <div class="user-more"></div>
                            </div>
                        </div>
                    </div>
                <% } %>

                <% /*
                 * WP wp_nav_menu(array('menu_class' => 'mobile-ul', 'depth' => 4,
                 * 'walker' => new MyMenu())) —— inc/menu.php MyMenu Walker
                 * 转写为 vt_nav_menu()（scripts/helpers.js），菜单数据来自 _config.yml menu
                 */ %>
                <%- vt_nav_menu(vt_get_config('menu', []), 'mobile-ul') %>
