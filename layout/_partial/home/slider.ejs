<%
/**
 * slider.ejs ← templates/home/slider.php（1:1 转写）
 */
var slider_height = vt_get_config('slider_height', 300);
var slider_autoplay = vt_get_config('slider_autoplay', 5000);
var slider_items = vt_get_config('slider_items', []);
var slider_effect = vt_get_config('slider_effect', 'slide');

var top_items = vt_get_config('top_items', []);
%>

<style>
@media screen and (min-width:900px) {
    .swiper.swiper-container { height: <%= parseInt(slider_height, 10) %>px; }
}


</style>

<div class="main-container top">
    <div class="main-widget">

        <div class="swiper swiper-container"
            data-autoplay="<%= esc_attr(slider_autoplay) %>"
            data-effect="<%= esc_attr(slider_effect) %>" >
            <div class="swiper-wrapper">
                <% if (slider_items) { %>
                    <% slider_items.forEach(function(v){ %>
                        <%
                        var target = (typeof v['target'] !== 'undefined' && v['target']) ? 'target="_blank"' : '';
                        %>
                        <a class="swiper-slide" href="<%- esc_url(v['link'] || '') %>" <%= target %> >
                            <img src="<%- url_for(v['image'] || '') %>" alt="">
                            <% if (v['title']) { %>
                                <div class="slider-title"><%= v['title'] %></div>
                            <% } %>
                        </a>
                    <% }) %>
                <% } %>
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination"></div>
        </div>

        <div class="hot-img-widget">
            <% if (top_items) { %>
                <% top_items.forEach(function(v, k){ %>
                    <% if(k>1) return; %>
                    <%
                    var target = (typeof v['target'] !== 'undefined' && v['target']) ? 'target="_blank"' : '';
                    %>
                    <a class="item" href="<%- esc_url(v['link'] || '') %>" <%= target %> >
                        <img src="<%- url_for(v['image'] || '') %>" alt="">
                        <div class="title"><%= v['title'] %></div>
                    </a>
                <% }) %>
            <% } %>
        </div>

    </div>
</div>
