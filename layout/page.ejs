<%
/**
 * page.ejs ← page.php（1:1 转写）
 *
 * @author: vtheme <mail@vtheme.cn>
 * @link https://www.liublog.cn
 *
 * 全宽显示（WP: get_post_meta('_vt_article_full_width')）→ front-matter
 * full_width: true。需要使用 WP 的 page-links.php / page-fullwidth.php
 * 页面模板时，在 Markdown 的 front-matter 中写 layout: page-links /
 * layout: page-fullwidth。
 */

/* get_header() */
%><%- partial('_partial/header') %><%

var vt_config = vt_get_config();

// 全宽显示
var full_width = page.full_width;
var full_width_attribute = full_width ? 'full-width' : '';
%>


<% if(vt_get_config('breadcrumbs_enabled')){ %>
    <div class="main-container" <%= full_width_attribute %> >
        <div class="main-widget">
            <%- get_breadcrumbs() %>
        </div>
    </div>
<% } %>


<div class="main-container" <%= full_width_attribute %>>
    <div class="main-widget">
        <div class="article-widget">
            <h1 class="page-title">
                <%= page.title %>
            </h1>

            <div class="content-action">
                <% /* WP: current_user_can('manage_options') 管理员编辑链接（无后端，保留结构）
                <a href="..." class="widget-action">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>编辑</span>
                </a>
                */ %>
            </div>

            <div class="page-content content-style">
                <%
                /* the_content() —— 支持页面内分页 <!--nextpage-->（静态站单页输出） */
                %>
                <%- page.content %>
            </div>
        </div>
    </div><!-- .main-widget -->

    <% if(!full_width){ %>
        <div class="sider">
            <%- partial('_partial/sidebar', {name: 'default-sidebar'}) %>

            <%- vt_theme_ad('ad_sidebar') %>
        </div>
    <% } %>
</div>

<% /* get_footer() */ %>
<%- partial('_partial/footer') %>
