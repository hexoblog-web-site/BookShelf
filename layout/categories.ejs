<%
/**
 * categories.ejs —— 分类总览页布局
 *
 * WordPress 版主题没有 categories.php（WP 核心与 Mirage 主题均不生成
 * /categories/ 索引页，导航中的链接由站长在后台菜单自行设置；需要该页面时
 * 站长的做法是创建一个「页面」，由 page.php 模板渲染）。
 * Hexo 生成器不会自动生成 /categories/ 索引页，为避免导航 404，此处按
 * page.php 的结构 1:1 转写（面包屑 + page-title + 内容区 + 侧栏），
 * 内容区输出 WP CategoryWidget（inc/widget.php）的原始 DOM
 * （即侧栏"分类列表"小工具，_partial/widgets/category-list）。
 * 未新增任何 WP 主题中不存在的区块与样式。
 *
 * 使用方式：在 source/categories/index.md 的 front-matter 中写
 *   ---
 *   title: 分类
 *   layout: categories
 *   ---
 * full_width: true 可全宽显示（WP: get_post_meta('_vt_article_full_width')）。
 * Markdown 正文（可选）会显示在分类列表上方，对应 WP 的 the_content()。
 */

/* get_header() */
%><%- partial('_partial/header') %><%

var vt_config = vt_get_config();

// 全宽显示
var full_width = page.full_width;
var full_width_attribute = full_width ? 'full-width' : '';
%>


<% if(vt_get_config('breadcrumbs_enabled')){ %>
    <div class="main-container" <%= full_width_attribute %> >
        <div class="main-widget">
            <%- get_breadcrumbs() %>
        </div>
    </div>
<% } %>


<div class="main-container" <%= full_width_attribute %>>
    <div class="main-widget">
        <div class="article-widget">
            <h1 class="page-title">
                <%= page.title %>
            </h1>

            <div class="content-action">
                <% /* WP: current_user_can('manage_options') 管理员编辑链接（无后端，保留结构） */ %>
            </div>

            <div class="page-content content-style">
                <%
                /* the_content() —— 页面自定义正文（可选，对应 WP 页面内容） */
                %>
                <%- page.content %>

                <%
                /* WP: 页面内容区输出 CategoryWidget（inc/widget.php）
                   的原始 DOM —— 与侧栏"分类列表"小工具完全一致 */
                %>
                <%- partial('_partial/widgets/category-list') %>
            </div>
        </div>
    </div><!-- .main-widget -->

    <% if(!full_width){ %>
        <div class="sider">
            <%- partial('_partial/sidebar', {name: 'default-sidebar'}) %>

            <%- vt_theme_ad('ad_sidebar') %>
        </div>
    <% } %>
</div>

<% /* get_footer() */ %>
<%- partial('_partial/footer') %>
