<%
/**
 * category.ejs ← category.php（文章列表页-分类，1:1 转写）
 *
 * @author: vtheme <mail@vtheme.cn>
 * @link https://www.liublog.cn
 *
 * 数据源差异说明：
 *  - get_term_meta($cat,'vt_full_width'/'vt_list_type'/'vt-thumbnail')
 *    （inc/category.php 后台分类字段）→ _config.yml term_meta 按分类名映射：
 *        term_meta:
 *          分类名:
 *            vt_full_width: 0/1
 *            vt_list_type: 0/1
 *            vt-thumbnail: /path/to/image
 *  - Hexo 分类页数据由 generator category 提供：page.category、
 *    page.posts（分页后）、page.total、page.current、page.base。
 */

/* get_header() */
%><%- partial('_partial/header') %><%

var category = page.category;
// 防止分类不存在报错（WP: get_term 失败时输出 404 模板）
if (!category) {
%><%- partial('404') %><%
} else {

var term_meta_map = vt_get_config('term_meta', {}) || {};
var term_meta = term_meta_map[category] || {};

var full_width = term_meta['vt_full_width'];
var full_width_class = full_width==1 ? 'full-width' : '';

var vt_list_type = term_meta['vt_list_type'];
var vt_list_type_class = '';
if(vt_list_type > 0){
    var vt_columns_num = vt_get_config('vt_columns', 3);
    vt_list_type_class = 'vt-column vt-column-' + vt_columns_num;
}

// 获取分类第一篇文章的缩略图或者图片
var banner_image = url_for('/images/banner.jpg');

var term_meta_thumbnail = term_meta['vt-thumbnail'];
if(term_meta_thumbnail){
    banner_image = url_for(term_meta_thumbnail);
} else {
    var first_posts = (page.posts && page.posts.toArray ? page.posts.toArray() : []).slice(0, 1);
    if (first_posts.length) {
        var thumb = first_posts[0].cover || first_posts[0].banner;
        banner_image = thumb ? url_for(thumb) : banner_image;
    }
}
%>


<div class="banner" style="background-image: url(<%= esc_url(banner_image) %>)">
    <div class="banner-container">
        <h1 class="title"><%= esc_html(category) %></h1>
        <% if(page.description){ %>
            <div class="description"><%= page.description %></div>
        <% } %>
    </div>
</div>


<div class="main-container" class="<%= esc_attr(full_width_class) %>">
    <div class="main-widget">
        <%
        /* WP: WP_Query(cat, posts_per_page, ignore_sticky_posts, orderby date,
           paged) —— Hexo generator category 已按 per_page 分页提供 page.posts */
        var paged = page.current || 1;
        var posts_per_page = page.per_page || (page.posts ? page.posts.length : 0);
        %>

        <div class="media-list <%= esc_attr(vt_list_type_class) %>">
            <%
            if (page.posts && page.posts.length) {
                page.posts.forEach(function(post) {
            %>
                    <%- partial('_partial/card', {post: post}) %>
            <%
                });
            } else if (paged == 1) {
            %>
                <div class="no-content">
                    <img src="<%- url_for('/images/empty.png') %>" alt="">
                    <p><%= esc_html(__('Not content')) %></p>
                </div>
            <%
            }
            %>
        </div>

        <%
        /* paginate_links(array(current, total, type list, end_size 2, mid_size 2)) */
        var max_num_pages = page.total || 1;
        function linkFor(n) {
            return n === 1 ? url_for(page.base || '') : url_for((page.base || '') + 'page/' + n + '/');
        }
        %>

        <div class="vt-captain-pagination pagination-container">
            <%- vt_paginate_links({
                current: paged,
                total: max_num_pages,
                prev_text: '<i class="fas fa-chevron-left"></i>',
                next_text: '<i class="fas fa-chevron-right"></i>',
                'type': 'list',
                end_size: 2,
                mid_size: 2,
                linkFor: linkFor
            }) %>
        </div>

    </div>


    <% if(!full_width){ %>
        <div class="sider">
            <%- partial('_partial/sidebar', {name: 'default-sidebar'}) %>

            <%- vt_theme_ad('ad_sidebar') %>
        </div>
    <% } %>

</div>


<% } %>

<% /* get_footer() */ %>
<%- partial('_partial/footer') %>
